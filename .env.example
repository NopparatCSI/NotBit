# Browser + server: use the URL and publishable key from your chosen Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix secrets/private keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SEPOLIA_RPC_URL=
# Optional browser RPC: this value is public in the client bundle.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Existing Sepolia deployment recorded in docs/handoff.md. For local Hardhat,
# use ESCROW_CHAIN_ID=31337 and the contract address from your local deployment.
NEXT_PUBLIC_ESCROW_ADDRESS=0x3D32396Cd1017DeD8cCE5150b88Ee6fEb3ca6eBe
ESCROW_CHAIN_ID=11155111
ESCROW_START_BLOCK=12146825
ESCROW_RPC_URL=
# Optional server-only address override for an isolated local test deployment.
ESCROW_ADDRESS=

# Must belong to the evidenceSigner fixed on the deployed contract.
EVIDENCE_SIGNER_PRIVATE_KEY=
# Generate a random secret of at least 32 characters for the indexer endpoint.
INDEXER_SECRET=
# Optional alternative when a Vercel scheduler sends this bearer token.
CRON_SECRET=
# Dedicated sender with Sepolia gas for automatic overdue escalation.
INDEXER_SENDER_PRIVATE_KEY=

# Only needed to deploy a NEW contract. Existing deployments use their original roles.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
SEPOLIA_TREASURY_ADDRESS=
SEPOLIA_EVIDENCE_SIGNER_ADDRESS=
SEPOLIA_ADMIN_ADDRESS=
SEPOLIA_SUPER_ADMIN_ADDRESS=
