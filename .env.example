# Leave both entries empty to run the storefront with fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional browser-safe public RPC. Keep the private Alchemy URL on the server.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ESCROW_ADDRESS=
# Set to 31337 with a local deployment when testing escrow in Hardhat.
ESCROW_CHAIN_ID=11155111
ESCROW_RPC_URL=
# Optional server override when running a separate local escrow test server.
ESCROW_ADDRESS=
SEPOLIA_RPC_URL=
SUPABASE_SECRET_KEY=
EVIDENCE_SIGNER_PRIVATE_KEY=
ESCROW_START_BLOCK=
INDEXER_SECRET=
INDEXER_SENDER_PRIVATE_KEY=

# Sepolia contract deployment. Use a dedicated Sepolia-only deployer.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
SEPOLIA_TREASURY_ADDRESS=
SEPOLIA_EVIDENCE_SIGNER_ADDRESS=
SEPOLIA_ADMIN_ADDRESS=
SEPOLIA_SUPER_ADMIN_ADDRESS=
